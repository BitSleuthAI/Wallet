{
  "expo": {
    "name": "BitSleuth Wallet",
    "slug": "bitsleuth-wallet",
    "version": "1.1.6",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://rork.com/"
      },
      "eas": {
        "projectId": "d9e4224e-8289-45e2-92d4-39c45c34ff2e"
      }
    },
    "owner": "bitsleuth",
    "plugins": [
      "expo-build-properties",
      {
        "ios": {
          "useFrameworks": "static",
          "extraPods": [
            { "name": "GoogleUtilities", "modular_headers": true },
            { "name": "GoogleDataTransport", "modular_headers": true },
            { "name": "FirebaseCoreInternal", "modular_headers": true },
            { "name": "FirebaseCoreExtension", "modular_headers": true },
            { "name": "FirebaseInstallations", "modular_headers": true }
          ]
        }
      }
    ]
  }
}
